{
  "name": "minisoccer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && cross-env NEXT_DISABLE_ESLINT=1 next build",
    "start": "next start",
    "test": "jest --config jest.config.cjs",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "cloudinary": "^1.38.0",
    "framer-motion": "^12.43.0",
    "next": "^15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^1.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^4.16.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "@types/jest": "^30.0.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "jest": "^29.7.0",
    "prisma": "^4.16.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  }
}
