# Core
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Database (PostgreSQL/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Midtrans Sandbox Payment Gateway
# Get credentials from https://dashboard.sandbox.midtrans.com/
# Format: Mid-server-xxxxxxxxxxxxxxxx (without SB- prefix for sandbox)
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_BASE_URL="https://app.sandbox.midtrans.com/snap/v1/transactions"

# Guest Booking Configuration
# Fallback user ID for guest bookings (no authentication needed)
GUEST_USER_ID="00000000-0000-0000-0000-000000000000"

# Application Settings
NEXT_PUBLIC_APP_NAME="Mini Soccer"
NEXT_PUBLIC_APP_DESCRIPTION="Book your favorite soccer field online"

# Email Service (for invoices and receipts)
# Optional: only if you want email notifications
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@your-domain.com"

# Optional: For development/testing
SKIP_PAYMENT_GATEWAY="false"
