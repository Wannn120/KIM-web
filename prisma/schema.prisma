generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  super_admin
  manager
  staff
}

enum FieldStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  rescheduled
  completed
  expired
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  expired
  cancelled
}

enum PaymentMethod {
  Midtrans
  QRIS
  GoPay
  Dana
  ShopeePay
  OVO
  BCA
  BNI
  Mandiri
  Offline
}

enum InvoiceStatus {
  issued
  paid
  cancelled
  refunded
}

enum WebContentType {
  HERO
  ABOUT
  GALLERY
  FAQ
  CONTACT
  PAGE
}

enum ScheduleBlockType {
  BLOCK
  HOLIDAY
  MAINTENANCE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Field {
  id          String      @id @default(uuid()) @map("id")
  name        String      @map("name")
  location    String      @map("location")
  description String?     @map("description")
  price       Int         @map("price")
  type        String      @map("type")
  size        String      @map("size")
  capacity    Int         @map("capacity")
  rating      Float       @default(0) @map("rating")
  imageUrl    String?     @map("image_url")
  isActive    Boolean     @default(true) @map("is_active")
  status      FieldStatus @default(ACTIVE) @map("status")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  bookings      Booking[]
  schedules     FieldSchedule[]
  timeSlots     TimeSlot[]
  scheduleBlocks ScheduleBlock[]
  reviews       Review[]

  @@map("field")
}

model FieldSchedule {
  id          String   @id @default(uuid()) @map("id")
  fieldId     String   @map("field_id")
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  date        DateTime @map("date")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([fieldId, date, startTime])
  @@map("field_schedule")
}

model TimeSlot {
  id             String   @id @default(uuid()) @map("id")
  fieldId        String   @map("field_id")
  field          Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label          String?  @map("label")
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  durationMinutes Int     @map("duration_minutes")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("time_slot")
}

model ScheduleBlock {
  id           String           @id @default(uuid()) @map("id")
  fieldId      String           @map("field_id")
  field        Field            @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  startDate    DateTime         @map("start_date")
  endDate      DateTime         @map("end_date")
  title        String           @map("title")
  reason       String?          @map("reason")
  blockType    ScheduleBlockType @default(BLOCK) @map("block_type")
  createdById  String?          @map("created_by_id")
  createdBy    AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("schedule_block")
}

model Customer {
  id          String         @id @default(uuid()) @map("id")
  name        String         @map("name")
  email       String         @unique @map("email")
  phone       String         @map("phone")
  totalSpend  Int            @default(0) @map("total_spend")
  status      CustomerStatus @default(ACTIVE) @map("status")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  bookings    Booking[]

  @@map("customer")
}

model Booking {
  id            String        @id @default(uuid()) @map("id")
  fieldId       String        @map("field_id")
  field         Field         @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingDate   DateTime      @map("booking_date")
  startTime     String        @map("start_time")
  endTime       String        @map("end_time")
  durationHours Int           @map("duration_hours")
  totalPrice    Int           @map("total_price")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  status        BookingStatus @default(pending) @map("status")
  notes         String?       @map("notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  payments      Payment[]
  invoice       Invoice?
  reviews       Review[]

  @@map("booking")
}

model Payment {
  id              String        @id @default(uuid()) @map("id")
  bookingId       String        @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId   String        @unique @map("transaction_id")
  midtransOrderId String?       @unique @map("midtrans_order_id")
  snapToken       String?       @map("snap_token")
  snapUrl         String?       @map("snap_url")
  amount          Int           @map("amount")
  paymentMethod   PaymentMethod @default(Midtrans) @map("payment_method")
  provider        String        @default("Midtrans") @map("provider")
  status          PaymentStatus @default(pending) @map("status")
  paidAt          DateTime?     @map("paid_at")
  expiredAt       DateTime?     @map("expired_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invoice         Invoice?

  @@map("payment")
}

model Invoice {
  id            String        @id @default(uuid()) @map("id")
  invoiceNumber  String        @unique @map("invoice_number")
  bookingId      String        @unique @map("booking_id")
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId      String        @unique @map("payment_id")
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerName   String?       @map("customer_name")
  customerEmail  String?       @map("customer_email")
  customerPhone  String?       @map("customer_phone")
  subtotal       Int           @map("subtotal")
  tax            Int           @default(0) @map("tax")
  discount       Int           @default(0) @map("discount")
  total          Int           @map("total")
  status         InvoiceStatus @default(issued) @map("status")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("invoice")
}

model Review {
  id           String   @id @default(uuid()) @map("id")
  fieldId      String?  @map("field_id")
  field        Field?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  bookingId    String?  @map("booking_id")
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName String   @map("customer_name")
  rating       Int      @map("rating")
  comment      String   @map("comment")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("review")
}

model AuditLog {
  id             String    @id @default(uuid()) @map("id")
  action         String    @map("action")
  entity         String    @map("entity")
  entityId       String    @map("entity_id")
  changes        String?   @map("changes")
  ipAddress      String?   @map("ip_address")
  referenceEmail String?   @map("reference_email")
  adminUserId    String?   @map("admin_user_id")
  adminUser      AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("audit_log")
}

model WebContent {
  id         String         @id @default(uuid()) @map("id")
  type       WebContentType @map("type")
  key        String?        @unique @map("key")
  title      String         @map("title")
  body       String?        @map("body")
  metadata   Json?          @map("metadata")
  imageUrl   String?        @map("image_url")
  slug       String?        @unique @map("slug")
  isActive   Boolean        @default(true) @map("is_active")
  order      Int            @default(0) @map("order")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("web_content")
}

model ReportLog {
  id           String    @id @default(uuid()) @map("id")
  generatedById String?  @map("generated_by_id")
  generatedBy  AdminUser? @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  reportType   String    @map("report_type")
  format       String    @map("format")
  filters      Json?     @map("filters")
  fileUrl      String?   @map("file_url")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("report_log")
}

model AdminSetting {
  id          String   @id @default(uuid()) @map("id")
  key         String   @unique @map("key")
  value       String   @map("value")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_setting")
}

model AdminUser {
  id           String     @id @default(uuid()) @map("id")
  name         String     @map("name")
  email        String     @unique @map("email")
  passwordHash String     @map("password_hash")
  role         AdminRole  @default(staff) @map("role")
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions      AdminSession[]
  auditLogs     AuditLog[]
  scheduleBlocks ScheduleBlock[]
  reportLogs    ReportLog[]

  @@map("admin_user")
}

model AdminSession {
  id          String    @id @default(uuid()) @map("id")
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_session")
}
